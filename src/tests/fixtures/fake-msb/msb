#!/usr/bin/env bash
# Fake msb for unit tests. Simulates msb status/create/start/stop/remove/exec
# without creating real sandboxes.
SUBCMD="${1:-}"

case "$SUBCMD" in
  status)
    NAME="${2:-}"
    if [[ -f "/tmp/fake-msb-${NAME}.state" ]]; then
      STATE=$(cat "/tmp/fake-msb-${NAME}.state")
      echo "{\"status\":\"$STATE\"}"
    else
      echo "error: sandbox not found: $NAME" >&2
      exit 1
    fi
    ;;
  # `create` is no longer invoked from production code — sandbox creation
  # now goes through scripts/create-sandbox.mjs (the SDK path). Tests
  # toggle GLOVEBOX_FAKE_CREATE=1 and that script writes the same
  # /tmp/fake-msb-<name>.create-args fixture file (as JSON now, not argv).
  start)
    NAME="${2:-}"
    echo "Running" > "/tmp/fake-msb-${NAME}.state"
    ;;
  stop)
    NAME="${2:-}"
    echo "Stopped" > "/tmp/fake-msb-${NAME}.state"
    ;;
  remove)
    NAME="${2:-}"
    rm -f "/tmp/fake-msb-${NAME}.state"
    ;;
  list)
    # Mimic `msb list` output: one line per running sandbox.
    # Real format: NAME  IMAGE  STATUS  STARTED_AT — we only need NAME + status,
    # but emit a similar shape so awk patterns in the shim still match.
    for f in /tmp/fake-msb-*.state; do
      [[ -f "$f" ]] || continue
      n="${f#/tmp/fake-msb-}"
      n="${n%.state}"
      s="$(cat "$f" 2>/dev/null)"
      if [[ "$s" == "Running" ]]; then
        printf '%s\tubuntu\trunning\t%s\n' "$n" "$(date '+%Y-%m-%d %H:%M:%S')"
      fi
    done
    ;;
  exec)
    # msb exec [--env KEY=VAL ...] <name> -- <cmd> [args...]
    shift              # skip "exec" subcommand
    ENV_ARGS=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --env|-e)
          ENV_ARGS+=("$2")
          shift 2
          ;;
        *)
          break
          ;;
      esac
    done
    NAME="${1:-}"
    shift || true
    if (( ${#ENV_ARGS[@]} > 0 )); then
      printf '%s\n' "${ENV_ARGS[@]}" > "/tmp/fake-msb-${NAME}.exec-env"
    fi
    [[ "${1:-}" == "--" ]] && shift  # skip "--"

    CMD="${1:-bash}"
    shift || true

    case "$CMD" in
      bash)
        if [[ "${1:-}" == "-c" ]]; then
          # bash -c <script>: run the script directly (e.g. SessionStart probe).
          shift
          bash -c "$1"
        else
          # Bash rewrite: decode base64-piped command from stdin
          cat | bash
        fi
        ;;
      cat)
        # Read hook: return fake sandbox content for the requested path
        FILE="${1:-}"
        FIXTURE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/fixtures" 2>/dev/null && pwd || echo "")"
        FIXTURE="$FIXTURE_DIR$FILE"
        if [[ -n "$FIXTURE_DIR" && -f "$FIXTURE" ]]; then
          cat "$FIXTURE"
        else
          echo "FAKE_SANDBOX_CONTENT: $FILE"
        fi
        ;;
      *)
        "$CMD" "$@"
        ;;
    esac
    ;;
  *)
    echo "fake-msb: unknown subcommand $SUBCMD" >&2
    exit 1
    ;;
esac
