#!/usr/bin/env bash
# Fake msb for unit tests. Simulates msb status/create/start/stop/remove
# without creating real sandboxes.
SUBCMD="${1:-}"

case "$SUBCMD" in
  status)
    # Positional: msb status <name> [--format json]
    NAME="${2:-}"
    if [[ -f "/tmp/fake-msb-${NAME}.state" ]]; then
      STATE=$(cat "/tmp/fake-msb-${NAME}.state")
      echo "{\"status\":\"$STATE\"}"
    else
      echo "error: sandbox not found: $NAME" >&2
      exit 1
    fi
    ;;
  create)
    # Extract --name value
    NAME=""
    while [[ $# -gt 0 ]]; do
      if [[ "$1" == "--name" ]]; then NAME="$2"; fi
      shift
    done
    [[ -z "$NAME" ]] && NAME="unnamed"
    echo "Running" > "/tmp/fake-msb-${NAME}.state"
    ;;
  start)
    NAME="${2:-}"
    echo "Running" > "/tmp/fake-msb-${NAME}.state"
    ;;
  stop)
    NAME="${2:-}"
    echo "Stopped" > "/tmp/fake-msb-${NAME}.state"
    ;;
  remove)
    NAME="${2:-}"
    rm -f "/tmp/fake-msb-${NAME}.state"
    ;;
  exec)
    # msb exec <name> -- bash: decode and run the piped command
    cat | bash
    ;;
  *)
    echo "fake-msb: unknown subcommand $SUBCMD" >&2
    exit 1
    ;;
esac
