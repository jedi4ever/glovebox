{
  "name": "glovebox",
  "version": "0.1.0",
  "description": "Integration tests for the glovebox Claude Code plugin",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "claude plugin validate plugins/glovebox",
    "prepare": "chmod +x plugins/glovebox/scripts/*.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
